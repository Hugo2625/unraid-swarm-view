  <?if (!$sv_need):?><span class="sv-dim"><?=sv_e('off – no feature that needs it is switched on (notifications, update hints, return)')?></span>
  <?elseif ($sv_late):?><span class="sv-bad"><?=sv_e('not running')?></span> <span class="sv-dim">– <?=sv_e('last run: {0}', $sv_ago($sv_last))?> · <?=sv_e('Pressing "Apply" once sets up the cron entry again.')?></span>
  <?else:?><span class="sv-ok"><?=sv_e('running')?></span> <span class="sv-dim">– <?=sv_e('last run: {0}', $sv_ago($sv_last))?></span><?endif;?>
