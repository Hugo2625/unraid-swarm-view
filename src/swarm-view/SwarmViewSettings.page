<div class="sv-set-title"><i class="fa fa-list"></i> <?=sv_e('Latest notifications and events')?></div>
<?php
  $sv_feed = [];
  foreach ($sv_mon['history'] ?? [] as $hst) $sv_feed[] = ['t' => $hst['t'], 'cls' => ['normal' => 'sv-ok', 'warning' => 'sv-warn', 'alert' => 'sv-bad'][$hst['level']] ?? '', 'icon' => 'fa-bell', 'text' => $hst['subject'] . ' – ' . $hst['desc']];
  foreach ($sv_mon['events'] ?? [] as $ev) $sv_feed[] = ['t' => $ev['t'], 'cls' => 'sv-dim', 'icon' => 'fa-cog', 'text' => $ev['text']];
  usort($sv_feed, fn($x, $y) => $y['t'] <=> $x['t']);
  $sv_feed = array_slice($sv_feed, 0, 10);
?>
<?if (!$sv_feed):?><p class="sv-dim"><?=sv_e('Nothing yet – the watchdog has not reported or changed anything so far.')?></p>
<?else:?><table class="sv-feed"><?foreach ($sv_feed as $f):?>
  <tr><td class="sv-dim" style="white-space:nowrap"><?=$sv_date($f['t'], true)?></td><td><i class="fa <?=$f['icon']?> <?=$f['cls']?>"></i></td><td><?=htmlspecialchars($f['text'])?></td></tr>
<?endforeach;?></table><?endif;?>
<blockquote class="inline_help">
  <?=sv_e('Notifications are the messages sent through Unraid; events are actions of the watchdog (return to the preferred node, update checks). The history is kept in RAM and is empty after a reboot of Unraid.')?>
</blockquote>
